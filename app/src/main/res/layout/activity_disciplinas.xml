<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Título da Tela -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grade Curricular"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:layout_marginTop="16dp"/>

    <!-- Nova instrução para o usuário -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecione uma disciplina:"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <!-- Container das Disciplinas com Botões -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E0E0E0"
        android:padding="16dp"
        android:layout_marginBottom="32dp">

        <Button
            android:id="@+id/btnProgramacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Programação" />

        <Button
            android:id="@+id/btnBancoDados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Banco de Dados" />

        <Button
            android:id="@+id/btnEngSoftware"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Engenharia de Software" />

        <Button
            android:id="@+id/btnDesWeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Desenvolvimento Web" />

        <Button
            android:id="@+id/btnDesMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Desenvolvimento Mobile" />

        <Button
            android:id="@+id/btnIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inteligência Artificial" />

    </LinearLayout>

    <!-- Botão Voltar (mantido igual) -->
    <Button
        android:id="@+id/btnVoltarDisciplinas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voltar à tela anterior" />

</LinearLayout>